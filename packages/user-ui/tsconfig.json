{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@job-portal/common/src": ["../common/src/index.ts"],
      "@job-portal/common/src/*": ["../common/src/*"]
    }
  },
  "include": [
    "src",
    "../common/src"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
