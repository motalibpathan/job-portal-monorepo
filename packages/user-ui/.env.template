# Base URL of the job-portal-server API (must match the server's PORT)
VITE_API_BASE_URL=http://localhost:7000

# Google OAuth Client ID (Google Identity Services) for "Continue with Google"
# Create one at https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# Root domain used for company subdomains, e.g. https://{companyUserName}.{root}
# In local dev this is only used as a fallback for the ?company= redirect.
VITE_APP_ROOT_URL=localhost:3004
